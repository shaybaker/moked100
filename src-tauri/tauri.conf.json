{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moked100",
  "version": "1.1.0",
  "identifier": "digital.levitate.moked100",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "מוקד 100 - משחק השוטרים",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Levitate Digital",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": [
          "Hebrew",
          "English"
        ]
      },
      "wix": {
        "language": "he-IL"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "מוקד 100 - משחק שוטרים לילדים",
    "longDescription": "מערכת מוקד משטרתי מדומה לילדים: קריאות, מצלמות אבטחה, שליחת כוחות, דוח אירוע וציון מפקד."
  }
}